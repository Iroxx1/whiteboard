# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# --- Docker Compose ---
# Image tag to run, e.g. sha-1a2b3c4 (see GitHub → Packages). "latest" follows main.
WB_IMAGE_TAG=latest
# Interface for port 3000: 0.0.0.0 when the Cloudflare connector runs on another LAN host,
# 127.0.0.1 when cloudflared runs in this stack (profile "tunnel").
WB_BIND=127.0.0.1

# --- App ---
# Public address (without trailing slash). Used for cookies, CSRF checks and card links.
PUBLIC_URL=https://board.example.de
# Name in the Android share sheet and on the home screen.
APP_NAME=Whiteboard
TZ=Europe/Berlin
DATA_DIR=/data
# Upload limit per file in MB (Cloudflare allows 100 MB per request).
MAX_UPLOAD_MB=100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated IPs of reverse proxies whose X-Forwarded-For / CF-Connecting-IP is trusted,
# e.g. the host running the Cloudflare connector. Used for login rate limits and the session list.
TRUSTED_PROXIES=

# Accounts: on the first start without accounts the app logs a one-time setup link
# (`docker compose logs app | grep setupUrl`). No setting needed.

# --- Cloudflare tunnel in this stack (optional, profile "tunnel") ---
CF_TUNNEL_TOKEN=

# --- Later phases ---
# Phase 4: Telegram bot token from @BotFather; empty = bot off.
TELEGRAM_BOT_TOKEN=
# Phase 5: at least 32 random characters, identical to INGEST_TOKEN in the Cloudflare email worker;
# empty = e-mail inbox off. Generate e.g. with: openssl rand -base64 36 | tr -d '/+='
EMAIL_INGEST_TOKEN=
# Inbox address shown in the settings (Cloudflare Email Routing rule → worker).
EMAIL_ADDRESS=
# Phase 8: OCR
OCR_ENABLED=false
OCR_LANGS=deu+eng
# Phase 9: speech to text
TRANSCRIBE_ENABLED=false
WHISPER_URL=http://whisper:8080/inference
